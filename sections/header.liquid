{% assign layout = section.settings.layout | default: 'logo-left' %}

<header
  class="site-header"
  data-sticky-header
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    --header-text-color: {{ section.settings.text_color | default: '#333333' }};
  "
>
  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
    <div class="site-header__announcement">
      {{ section.settings.announcement_text }}
    </div>
  {% endif %}
  <div class="site-header__inner site-header__inner--{{ layout }}">
    <!-- Logo -->
    <div class="site-header__logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            height=""
            width=""
          >
        {% else %}
          {{ shop.name }}
        {% endif %}
      </a>
    </div>

    <!-- Mobile menu toggle (checkbox + icon) -->
    <input
      type="checkbox"
      id="mobile-nav-toggle"
      class="site-header__checkbox"
    >
    <label for="mobile-nav-toggle" class="site-header__toggle" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <!-- Navigation -->
    <nav class="site-header__nav">
      {% assign menu_handle = section.settings.menu | default: 'main-menu' %}
      {% if linklists[menu_handle] %}
        {% for link in linklists[menu_handle].links %}
          {{ link.title }}
          <!-- This is a submenu -->
          <ul class="submenu">
            {% for sub in link.links %}
              <li>
                <a href="{{ sub.url }}">{{ sub.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endfor %}
      {% endif %}
    </nav>

    <!-- Actions -->
    <div class="site-header__actions">
      {% if section.settings.show_search %}
        <a href="{{ routes.search_url }}" class="site-header__icon">🔍</a>
      {% endif %}

      {% if shop.customer_accounts_enabled and section.settings.show_account %}
        <a href="{{ routes.account_url }}" class="site-header__icon">👤</a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="site-header__icon">🛒</a>
    </div>
  </div>
</header>

<script>
  console.log("Hello from JS!");
</script>

<script type="module" src="{{ '/custom/header.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Simple header",
  "tag": "header",
  "class": "site-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon (if accounts enabled)",
      "default": true
    },
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Welcome to our store – free shipping over $50!"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Header text & icon color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Header layout",
      "options": [
        {
          "value": "logo-left",
          "label": "Logo left"
        },
        {
          "value": "logo-center",
          "label": "Logo center"
        },
        {
          "value": "logo-right",
          "label": "Logo right"
        }
      ],
      "default": "logo-left"
    }
  ],
  "presets": [
    {
      "name": "Simple header"
    }
  ]
}
{% endschema %}
